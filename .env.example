# --- Database ---
DB_HOST=localhost
DB_NAME=jali_oltp
DB_USER=postgres
DB_PASS=password
DB_PORT=5432

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=JALI_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- AfricasTalking SMS (for live alerts & two-way chat) ---
AT_USERNAME=sandbox          # Use your real AT username when going live
AT_API_KEY=your_at_api_key
AT_SHORTCODE=90415           # Your AfricasTalking shortcode - users SMS this number
AT_SENDER_ID=                # Optional alphanumeric sender (only used when no shortcode)


# --- OpenAI (for LLM agent) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlruns.db

# --- User Contacts (for outbound alerts) ---
# Add a line for each user. Key = USER_<user_id>_PHONE or USER_<user_id>_WHATSAPP
# Example:
# USER_user_123_PHONE=+254700000000
# USER_user_456_PHONE=+254711111111
